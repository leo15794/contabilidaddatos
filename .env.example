# URL de conexión a Postgres (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Cadena aleatoria larga para firmar la sesión. Generarla con:
#   openssl rand -base64 32
AUTH_SECRET=

# Hash bcrypt de la contraseña de acceso a la app. Generarlo con:
#   node scripts/hash-password.mjs "tu-contraseña"
APP_PASSWORD_HASH=

# --- Agente de WhatsApp para tickets/comprobantes ---

# API key de Anthropic (console.anthropic.com/settings/keys) para leer los tickets.
ANTHROPIC_API_KEY=

# Opcional: modelo a usar para leer los tickets. Por defecto claude-sonnet-5.
ANTHROPIC_MODEL=

# URL pública de OpenWA (el gateway de WhatsApp que corre en el VPS, ver
# openwa/), sin / al final. Ej: https://openwa.tu-vps.com
OPENWA_URL=

# API key de OpenWA (rol OPERATOR o ADMIN) para mandar la respuesta por
# WhatsApp después de cargar cada ticket.
OPENWA_API_KEY=

# ID de la sesión de WhatsApp creada en OpenWA (la que vinculaste escaneando
# el QR con el WhatsApp de los dueños).
OPENWA_SESSION_ID=

# Cualquier string aleatorio largo que vos inventes. Se configura acá Y al
# crear el webhook en OpenWA (como "secret") — tienen que coincidir. Se usa
# para verificar la firma HMAC de cada entrega a /api/tickets/ingest.
#   openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=

# Teléfonos de los dueños autorizados a mandar tickets, separados por coma,
# en formato internacional sin '+' (ej: 5493411234567,5493413456789).
WHATSAPP_ALLOWED_NUMBERS=
