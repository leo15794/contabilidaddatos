# URL de conexión a Postgres (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Cadena aleatoria larga para firmar la sesión. Generarla con:
#   openssl rand -base64 32
AUTH_SECRET=

# Hash bcrypt de la contraseña de acceso a la app. Generarlo con:
#   node scripts/hash-password.mjs "tu-contraseña"
APP_PASSWORD_HASH=
